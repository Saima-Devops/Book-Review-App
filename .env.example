# Reference only. Use scripts/configure-env.py on the VM for real values.
PUBLIC_URL=http://YOUR_EC2_PUBLIC_IP
MYSQL_DATABASE=book_review_db
MYSQL_USER=bookreview_user
MYSQL_ROOT_PASSWORD=REPLACE_WITH_A_RANDOM_32_CHARACTER_OR_LONGER_SECRET
MYSQL_PASSWORD=REPLACE_WITH_A_DIFFERENT_RANDOM_32_CHARACTER_OR_LONGER_SECRET
JWT_SECRET=REPLACE_WITH_ANOTHER_RANDOM_32_CHARACTER_OR_LONGER_SECRET
APP_IMAGE_TAG=local
# New deployment default. Existing installations can use reading-room_mysql_data.
DB_VOLUME_NAME=reading-room_db_data
# Optional digest-pinned images after testing:
NODE_IMAGE=node:22-alpine
MYSQL_IMAGE=mysql:8.4
NGINX_IMAGE=nginxinc/nginx-unprivileged:stable-alpine

# Optional password-recovery email; see docs/password-recovery.md.
# Use a verified sender and an SMTP app password, never your mailbox password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional managed MySQL TLS (direct backend hosting, not required by local Compose).
# Set DB_SSL=true and supply exactly one CA option in your hosting service.
DB_SSL=false
DB_SSL_CA=
DB_SSL_CA_FILE=
# Frontend-only runtime setting for hosting without the existing Nginx proxy.
# Use the backend HTTPS origin, with no /api suffix. Leave empty for Compose.
BACKEND_API_ORIGIN=
# Backend-only admin account IDs; empty disables all moderation access.
ADMIN_USER_IDS=
