# Reference only. Use scripts/configure-env.sh on the VM for real values.
PUBLIC_URL=http://YOUR_EC2_PUBLIC_IP
MYSQL_DATABASE=book_review_db
MYSQL_USER=bookreview_user
MYSQL_ROOT_PASSWORD=REPLACE_WITH_A_RANDOM_32_CHARACTER_OR_LONGER_SECRET
MYSQL_PASSWORD=REPLACE_WITH_A_DIFFERENT_RANDOM_32_CHARACTER_OR_LONGER_SECRET
JWT_SECRET=REPLACE_WITH_ANOTHER_RANDOM_32_CHARACTER_OR_LONGER_SECRET
APP_IMAGE_TAG=local
# New deployment default. Existing installations can use reading-room_mysql_data.
DB_VOLUME_NAME=reading-room_db_data
# Optional digest-pinned images after testing:
NODE_IMAGE=node:22-alpine
MYSQL_IMAGE=mysql:8.4
NGINX_IMAGE=nginxinc/nginx-unprivileged:stable-alpine
